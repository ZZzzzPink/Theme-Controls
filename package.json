{
  "name": "dsh-theme-controls",
  "version": "0.1.0",
  "description": "Background image and typography controls for DSH Web settings",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js" },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE"],
  "keywords": ["dsh", "deepseek-harness", "theme", "typography", "background"],
  "repository": {
    "type": "git",
    "url": "https://github.com/ZZzzzPink/Theme-Controls.git"
  },
  "bugs": {
    "url": "https://github.com/ZZzzzPink/Theme-Controls/issues"
  },
  "homepage": "https://github.com/ZZzzzPink/Theme-Controls#readme",
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
